server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  # The words and web addresses of this installation (see frontend/src/terminology/profiles.json).
  # TERMINOLOGY_PROFILE is filled in when the container starts.
  location = /config.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"terminology":"${TERMINOLOGY_PROFILE}"}';
  }

  location / {
    try_files $uri /index.html;
  }
}
