# Default values for local development. This file is committed: it must contain NO secrets.
# `make env` creates .env from it (and fills in a random POSTGRES_PASSWORD). .env is git-ignored.
# The application and docker compose have no built-in defaults: every value below must be set
# in the environment, so a missing value fails at startup instead of silently using a guess.

# Runtime environment: local | ci | demo | prod  (demo and prod enforce strong secrets)
ENVIRONMENT=local

# Database (the password is a secret: generated by `make env`, never written here)
POSTGRES_USER=skills
POSTGRES_DB=skills
POSTGRES_PASSWORD=

# Authentication. JWT_SECRET and DEMO_USER_PASSWORD are secrets: generated by `make env`, never written here.
JWT_SECRET=
DEMO_USER_PASSWORD=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESET_TOKEN_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
REVEAL_MAX_PER_HOUR=10
REVEAL_MAX_PER_DAY=20
FRONTEND_BASE_URL=http://localhost:5173

# Ports published on the host by docker compose / used by local tools
DB_PORT=5432
API_PORT=8000
WEB_PORT=5173

# Application settings
CORS_ORIGINS=http://localhost:5173
REPORT_TIMEZONE=Asia/Dubai
# The words and web addresses shown to people: default or church (frontend/src/terminology)
TERMINOLOGY_PROFILE=default
# Folder for generated report files (CSV and HTML). In docker compose the api and worker use /data/reports.
REPORTS_OUTPUT_DIR=reports_output
