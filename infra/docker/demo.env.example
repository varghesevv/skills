# The variables the demo server needs in /opt/skills/.env. The deploy workflow writes that file
# from the GitHub Environment `demo` (variables for plain values, secrets for the blank ones
# below). This example holds NO secrets and is only a checklist.

ENVIRONMENT=demo
SITE_ADDRESS=skills-demo.privatedir.in
FRONTEND_BASE_URL=https://skills-demo.privatedir.in
CORS_ORIGINS=https://skills-demo.privatedir.in
REPORT_TIMEZONE=Asia/Dubai
# The words and web addresses shown to people: default or church (frontend/src/terminology)
TERMINOLOGY_PROFILE=default
# Mobile app versions (X.Y.Z, not secrets). Apps older than the minimum ask the person to update.
APP_MIN_VERSION=0.0.0
APP_LATEST_VERSION=0.0.0

# Which images to run (set by the deploy workflow)
GHCR_OWNER=
IMAGE_TAG=

POSTGRES_USER=skills
POSTGRES_DB=skills
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RESET_TOKEN_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
REVEAL_MAX_PER_HOUR=10
REVEAL_MAX_PER_DAY=20

# Backups (scripts on the host read these; they are not passed into containers)
BACKUP_BUCKET=
AWS_DEFAULT_REGION=ap-south-1

# SECRETS: GitHub Environment secrets, never written here
POSTGRES_PASSWORD=
JWT_SECRET=
DEMO_USER_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, only to use pgAdmin (docs/operations-runbook.md): the login password, 16+ characters.
# PGADMIN_EMAIL is a plain Environment variable (the login name; optional).
PGADMIN_PASSWORD=
